# ─── Clipmark — Environment Variables ────────────────────────────────────────
#
# Setup:
#   cp .env.example .env
#   Fill in the values below, then: npm run dev
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Settings → API → service_role (used by webhooks + migration runner)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Settings → Database → Connection string → URI, Session mode pooler (port 5432)
# Used by: npm run db:migrate (run explicitly — NOT part of the build)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000  |  Production: your Vercel URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional override for every "Add to Chrome" install CTA. Leave unset — the real
# listing URL is the fallback in app/lib/constants.ts. Set this only to re-point
# the CTAs at a different Chrome Web Store item (a replacement listing, or an
# unlisted/staging build). BUILD-TIME INLINED: changing it needs a redeploy.
# NEXT_PUBLIC_CHROME_STORE_URL=

# ── AI Strategy ──────────────────────────────────────────────────────────────
# All AI features are handled client-side via Chrome's Gemini Nano (built-in).
# No external AI API keys are required for core features.

# ── YouTube Data API ──────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → Create API Key
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key-here

# ── Dodo Payments ─────────────────────────────────────────────────────────────
# https://app.dodopayments.com → Settings → API Keys
DODO_PAYMENTS_API_KEY=your-dodo-api-key-here
# https://app.dodopayments.com → Webhooks → your endpoint → signing secret
DODO_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret-here
# Product IDs — create these in the Dodo dashboard under Products
DODO_MONTHLY_PRODUCT_ID=your-monthly-product-id
DODO_ANNUAL_PRODUCT_ID=your-annual-product-id
DODO_LIFETIME_PRODUCT_ID=your-lifetime-product-id

# ── Admin Panel ───────────────────────────────────────────────────────────────
# Comma-separated Supabase user UUIDs with admin access to /admin
# Find your UUID: Supabase dashboard → Authentication → Users → copy the UUID
ADMIN_USER_IDS=your-supabase-user-uuid-here

# Cache busting — used by POST /api/revalidate-prices to clear Dodo price cache
REVALIDATE_SECRET=generate-a-random-secret-here

# ── Sentry (error monitoring) ─────────────────────────────────────────────────
# These six are the ONLY Sentry env vars the code reads. The Sentry org and
# project are hardcoded in next.config.mjs (org: 'mithahara', project:
# 'clipmark-web') — there is no SENTRY_ORG / SENTRY_PROJECT to set. The Chrome
# extension has its own DSN committed in extension/src/error-reporting.js and
# needs nothing here.
#
# REQUIRED — the public DSN. Nothing is reported without it.
#   Where: https://mithahara.sentry.io → clipmark-web → Settings → Client Keys (DSN)
#   PUBLIC + BUILD-TIME INLINED. Any NEXT_PUBLIC_* value is baked into the bundle
#   at `next build`, server bundles included — so changing it in Vercel requires a
#   REDEPLOY, not a restart. A DSN is write-only by design: safe to expose.
#   Leave blank to disable error reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
#
# Optional, SERVER-ONLY. Same DSN value, read at RUNTIME, and takes precedence
# over the public var on the server. Use it to repoint server/edge errors to a
# different project without rebuilding. Has no effect in the browser.
# SENTRY_DSN=
#
# Optional, PUBLIC + BUILD-TIME. Overrides the environment tag on every event.
# On Vercel this is inferred from NEXT_PUBLIC_VERCEL_ENV (production / preview /
# development), so you normally do NOT set it. Useful locally.
# NEXT_PUBLIC_SENTRY_ENV=local
#
# Optional, PUBLIC + BUILD-TIME. Set to 1 to report from `next dev`. Off by
# default so local hot-reload noise doesn't consume the 5k errors/month free
# quota (which is shared org-wide with clipmark-extension).
# NEXT_PUBLIC_SENTRY_DEV=1
#
# Optional, PUBLIC + BUILD-TIME. Set to 1 to log every envelope to the console.
# Also disables Sentry's log tree-shaking, without which `debug` is a silent
# no-op. Verification aid only — leave off normally.
# NEXT_PUBLIC_SENTRY_DEBUG=1
#
# Optional but wanted, SERVER-ONLY BUILD-TIME SECRET — never commit this.
# Uploads source maps so production stack traces are readable instead of
# minified. Builds succeed without it; they just upload nothing.
#   Where: https://mithahara.sentry.io → Settings → Auth Tokens → Create New Token
#          scope: project:releases
#   Set it in Vercel's env vars, not in this file.
# SENTRY_AUTH_TOKEN=
