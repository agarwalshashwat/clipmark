{
  "name": "clipmark",
  "version": "1.0.0",
  "description": "Chrome extension + webapp to bookmark, revisit, and share YouTube video moments",
  "scripts": {
    "sync-tokens": "node scripts/sync-design-tokens.js",
    "test": "npm run test:unit && npm run test:yt && npm run test:visual",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:yt": "playwright test --project=extension",
    "test:yt:smoke": "playwright test --project=extension tests/ci/extension-smoke.spec.ts",
    "test:auth-bridge": "playwright test --project=extension tests/auth-bridge.spec.ts",
    "test:design:rendered": "playwright test --project=extension tests/design-consistency.spec.ts",
    "test:visual": "playwright test --project=webapp",
    "test:webapp:smoke": "playwright test --project=webapp tests/ci/webapp-smoke.spec.ts",
    "test:unit:webapp": "npm --prefix webapp run test:unit",
    "test:integration": "npm --prefix webapp run test:integration",
    "test:all": "npm run test:unit && npm run test:yt && npm run test:visual",
    "ext-build": "npm --prefix extension run build",
    "design:audit": "node scripts/design-audit.mjs",
    "design:audit:dist": "node scripts/design-audit.mjs --dist",
    "ext:verify": "node extension/scripts/bundle-resolve-guard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  },
  "keywords": [
    "youtube",
    "bookmarks",
    "chrome-extension"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true
}
