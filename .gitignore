yarn-error.log*

# Next.js
webapp/.next/
webapp/out/

# Production
webapp/build

# Environment variables
.env
webapp/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Sentry — written by the build plugin / wizard, contains an auth token
.env.sentry-build-plugin
.sentryclirc

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
.claude/
deep-research-*
clipmark-extension.zip

# Playwright
playwright-report/
test-results/
tests/visual/__snapshots__/
*-snapshots/

# extension/src/config.js is committed as the production default (no secrets —
# just the public API base URL). Override it locally for dev; the extension
# build guard in vite.config.mjs fails the build if API_BASE points at localhost.
extension/dist/
screenshots/
clipmark-extension-*.zip

# Release candidates cut by scripts/cut-release.sh — build outputs, never committed.
# The zip that goes to the Chrome Web Store is rebuilt from the tagged commit.
release-artifacts/

# Defensive net for credential files that must never enter this (or any) repo.
# The real CWS publish service-account key lives out-of-repo at
# ~/.config/cws/service-account.json — nothing under this name should ever
# legitimately exist here, so these patterns exist purely to catch an accident.
service-account*.json
*.iam.gserviceaccount.com.json
*-key.json
*.pem
.secrets/
secrets/*.json
